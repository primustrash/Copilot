# PrimusNEX MCP — local environment template
# Copy this file to .mcp/.env.local and fill in your token.
# DO NOT commit .mcp/.env.local — it is listed in .gitignore.

# PrimusNEX MCP server bearer token
# Obtain from your PrimusNEX dashboard or administrator.
COPILOT_MCP_PRIMUSNEX_TOKEN=your-token-here

# ── mcp-security-addon optional API keys ────────────────────────────────────────
# Required only if you use the security addon Shodan tools.
SHODAN_API_KEY=

# Required only if you use the MobSF mobile analysis tool.
MOBSF_API_KEY=
MOBSF_URL=http://localhost:8000
