# MCP Server Environment Variables
# Copy this file to .env and fill in values

# ─── Server ────────────────────────────────────────────────────────────────
MCP_PORT=3000
MCP_HOST=0.0.0.0
MCP_BASE_URL=http://localhost:3000
NODE_ENV=production

# ─── Database ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://mcpuser:mcppassword@localhost:5432/mcpdb
QDRANT_URL=http://localhost:6333

# ─── Authentication ────────────────────────────────────────────────────────
API_KEY_SECRET=change-me-to-a-random-256-bit-secret
JWT_SECRET=change-me-to-another-random-256-bit-secret
JWT_EXPIRY=1h

# OAuth 2.0
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/auth
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# ─── AI / LLM Providers ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── GitHub ────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/mcp/github-app.pem

# ─── SSH ───────────────────────────────────────────────────────────────────
SSH_KEY_PATH=/root/.ssh/id_rsa
SSH_KNOWN_HOSTS_PATH=/root/.ssh/known_hosts

# ─── Security ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed domains for browser/network tools
ALLOWED_DOMAINS=localhost,127.0.0.1
# Comma-separated list of allowed filesystem paths
ALLOWED_PATHS=/home,/tmp,/var/mcp
# Comma-separated list of allowed applications
ALLOWED_APPS=bash,python3,node,git
# Enable kill switch (emergency stop)
KILL_SWITCH_ENABLED=false
# API key for the kill switch endpoint
KILL_SWITCH_TOKEN=change-me-to-a-random-secret

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ─── Budget / Cost Control ─────────────────────────────────────────────────
BUDGET_MAX_TOKENS_PER_HOUR=100000
BUDGET_MAX_COST_USD_PER_DAY=10.00

# ─── Playwright / Browser ──────────────────────────────────────────────────
PLAYWRIGHT_SERVER_URL=ws://localhost:3001
PLAYWRIGHT_BROWSER=chromium

# ─── Audio ─────────────────────────────────────────────────────────────────
WHISPER_MODEL=base
AUDIO_SAMPLE_RATE=16000

# ─── Workspace ─────────────────────────────────────────────────────────────
WORKSPACE_ROOT=/var/mcp/workspaces
SANDBOX_ROOT=/var/mcp/sandboxes

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=/var/log/mcp-server/app.log
AUDIT_LOG_FILE=/var/log/mcp-server/audit.log
